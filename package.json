{
  "name": "medi-runner-challenge",
  "version": "1.0.0",
  "description": "Medi Runner Challenge 2025 - Autonomous Medical Delivery Robot",
  "main": "index.js",
  "scripts": {
    "install:all": "npm run install:backend && npm run install:frontend && npm run install:robot",
    "install:backend": "cd controller-backend && pnpm install",
    "install:frontend": "cd controller-front-end && pnpm install",
    "install:robot": "cd robot-server && pip3 install -r requirements.txt",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:robot\"",
    "dev:backend": "cd controller-backend && pnpm dev",
    "dev:frontend": "cd controller-front-end && pnpm dev",
    "dev:robot": "cd robot-server && python3 main.py",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd controller-backend && pnpm build",
    "build:frontend": "cd controller-front-end && pnpm build",
    "test": "npm run test:backend && npm run test:frontend && npm run test:robot",
    "test:backend": "cd controller-backend && pnpm test",
    "test:frontend": "cd controller-front-end && pnpm test",
    "test:robot": "cd robot-server && python3 -m pytest",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd controller-backend && pnpm lint",
    "lint:frontend": "cd controller-front-end && pnpm lint",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "robotics",
    "medical",
    "autonomous",
    "raspberry-pi",
    "nextjs",
    "websocket",
    "computer-vision"
  ],
  "author": "DIPS Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^7.6.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "python": ">=3.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DIPS-AS/medi-runner.git"
  },
  "bugs": {
    "url": "https://github.com/DIPS-AS/medi-runner/issues"
  },
  "homepage": "https://github.com/DIPS-AS/medi-runner#readme"
}